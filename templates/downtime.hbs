{{#with dt}}
<div class="nah-dt">
  {{!-- ================= STATUS STRIP ================= --}}
  <header class="nah-dt-strip {{#if state.active}}is-on{{/if}}">
    <div class="nah-dt-status">
      <span class="nah-kicker">{{localize "NEONHOME.Downtime.Title"}}</span>
      {{#if call}}
        <b>{{call.label}}</b>
        {{#if state.active}}
          {{#if state.timed}}
          <div class="nah-dt-clock" data-tooltip="{{localize 'NEONHOME.Downtime.SpentTip' spent=state.spent}}">
            <div class="nah-meter"><b style="width:{{state.pct}}%"></b></div>
            <small><i class="fa-regular fa-clock"></i> {{localize "NEONHOME.Downtime.Left" left=state.left}}</small>
          </div>
          {{/if}}
        {{else}}
          <small class="nah-dt-off">{{localize "NEONHOME.Downtime.NotTaking"}}</small>
        {{/if}}
      {{else}}
        <b class="nah-dt-off">{{localize "NEONHOME.Downtime.None"}}</b>
      {{/if}}
    </div>
    {{#if isGM}}
    <div class="nah-dt-gm">
      {{#if hub}}
      <button type="button" data-action="dtOpenHub"><i class="fa-solid fa-mug-hot"></i> {{#if call}}{{localize "NEONHOME.Downtime.OpenHub"}}{{else}}{{localize "NEONHOME.Downtime.CallHub"}}{{/if}}</button>
      {{else}}
      <button type="button" data-action="dtSwitch" data-on="{{#if manualOn}}0{{else}}1{{/if}}" class="{{#if manualOn}}on{{/if}}"><i class="fa-solid fa-power-off"></i> {{#if manualOn}}{{localize "NEONHOME.Downtime.End"}}{{else}}{{localize "NEONHOME.Downtime.Start"}}{{/if}}</button>
      {{/if}}
    </div>
    {{/if}}
  </header>

  <div class="nah-dt-body">
    {{!-- ================= ACTIONS ================= --}}
    <aside class="nah-dt-list nah-scroll">
      {{#each groups}}
      <h3 class="nah-kicker">{{label}}</h3>
      <ul>
        {{#each actions}}
        <li class="nah-dt-action {{#if selected}}selected{{/if}}" data-dt="{{id}}" data-action="dtSelect">
          <i class="{{icon}}"></i>
          <b>{{label}}</b>
          {{#if timeLabel}}<small>{{timeLabel}}</small>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/each}}
      {{#if roleNote}}<p class="nah-hint">{{roleNote}}</p>{{/if}}
    </aside>

    {{!-- ================= THE ACTION ================= --}}
    <main class="nah-dt-panel nah-scroll">
      {{#with selected}}
      <header class="nah-dt-head">
        <h2>{{label}}</h2>
        {{#if timeLabel}}<span class="nah-dt-time"><i class="fa-regular fa-clock"></i> {{timeLabel}}</span>{{/if}}
      </header>
      <p class="nah-dt-blurb">{{blurb}}</p>

      {{#if fields.length}}
      <div class="nah-dt-fields">
        {{#each fields}}
        <div class="nah-dt-field {{#if textarea}}is-wide{{/if}} {{#if drop}}is-wide{{/if}} {{#if pick}}is-wide{{/if}}">
          <label>{{label}}</label>
          {{#if select}}<select data-dt-field="{{name}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
          {{#if number}}<input type="number" data-dt-field="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}">{{/if}}
          {{#if text}}<input type="text" data-dt-field="{{name}}" value="{{value}}">{{/if}}
          {{#if textarea}}<textarea data-dt-field="{{name}}" rows="4">{{value}}</textarea>{{/if}}
          {{#if pick}}{{#with pick}}<div class="nah-timepick {{#if over}}is-over{{/if}}" data-max="{{max}}" data-value="{{value}}" data-max-label="{{maxLabel}}" {{#if name}}data-field="{{name}}"{{/if}}>
            <input type="range" min="0" max="{{max}}" step="15" value="{{value}}" data-tp-range aria-label="{{localize 'NEONHOME.Project.Pick'}}">
            <span class="nah-tp-boxes">
              <label><input type="number" min="0" step="1" value="{{d}}" data-tp-unit="1440" aria-label="{{localize 'NEONHOME.Project.Days'}}"><span>d</span></label>
              <label><input type="number" min="0" step="1" value="{{h}}" data-tp-unit="60" aria-label="{{localize 'NEONHOME.Project.Hours'}}"><span>h</span></label>
              <label><input type="number" min="0" step="1" value="{{m}}" data-tp-unit="1" aria-label="{{localize 'NEONHOME.Project.Minutes'}}"><span>m</span></label>
            </span>
            <small class="nah-tp-msg" data-tp-msg>{{#if over}}{{localize "NEONHOME.Project.TooMuch" max=maxText}}{{else}}{{label}} &middot; {{maxLabel}}{{/if}}</small>
          </div>{{/with}}{{/if}}
          {{#if drop}}
          <div class="nah-dt-drop" data-drop="fabricate">
            {{#if value}}<img src="{{value.img}}" alt=""><span><b>{{value.name}}</b><small>{{value.category}} &middot; {{value.skill}}</small></span>
            {{else}}<i class="fa-solid fa-arrow-down-to-bracket"></i><span>{{localize "NEONHOME.Downtime.DropHere"}}</span>{{/if}}
          </div>
          {{/if}}
          {{#if hint}}<small class="nah-hint">{{hint}}</small>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if facts.length}}
      <dl class="nah-dt-facts">
        {{#each facts}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
      </dl>
      {{/if}}

      {{#if table}}
      <table class="nah-dt-table">
        <tbody>{{#each table}}<tr><td>{{n}}</td><td>{{text}}</td><td>{{eb}}</td></tr>{{/each}}</tbody>
      </table>
      {{/if}}

      {{#if workshop}}
      <div class="nah-dt-workshop">
        <h4>{{localize "NEONHOME.Downtime.Due"}}</h4>
        <ul class="nah-dt-jobs">
          {{#each workshop.due}}
          <li data-item-id="{{id}}" {{#if stash}}data-holder="stash"{{/if}}><img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{#if stash}}<i class="fa-solid fa-box-archive"></i> {{localize "NEONHOME.Downtime.InStash"}} &middot; {{/if}}{{skill}} &middot; DV{{dv}} &middot; {{time}}</small></span>
            <button type="button" data-action="dtWork" data-mode="maintain" {{#unless @root.dt.can}}disabled{{/unless}}><i class="fa-solid fa-screwdriver-wrench"></i> {{localize "NEONHOME.Maint.Do.maintain"}}</button></li>
          {{else}}<li class="nah-hint">{{localize "NEONHOME.Downtime.NothingDue"}}</li>{{/each}}
        </ul>
        <h4>{{localize "NEONHOME.Downtime.Broken"}}</h4>
        <ul class="nah-dt-jobs">
          {{#each workshop.broken}}
          <li data-item-id="{{id}}" {{#if stash}}data-holder="stash"{{/if}}><img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{#if stash}}<i class="fa-solid fa-box-archive"></i> {{localize "NEONHOME.Downtime.InStash"}} &middot; {{/if}}{{skill}} &middot; DV{{dv}} &middot; {{time}}</small></span>
            <button type="button" data-action="dtWork" data-mode="repair" {{#unless @root.dt.can}}disabled{{/unless}}><i class="fa-solid fa-toolbox"></i> {{#if pct}}{{localize "NEONHOME.Project.CarryOn" pct=pct}}{{else}}{{localize "NEONHOME.Maint.Do.repair"}}{{/if}}</button></li>
          {{else}}<li class="nah-hint">{{localize "NEONHOME.Downtime.NothingBroken"}}</li>{{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if projects}}
      <ul class="nah-dt-projects">
        {{#each projects}}
        <li class="nah-proj stage-{{stage}}" data-project="{{id}}">
          <header>
            {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}
            <div><b>{{label}}</b><small>{{kind}} &middot; {{skill}} &middot; DV{{dv}}{{#if restarts}} &middot; <i class="fa-solid fa-rotate-left"></i> {{restarts}}{{/if}}</small></div>
            <span class="nah-proj-stage">{{stageLabel}}</span>
          </header>
          <div class="nah-proj-meter" data-tooltip="{{done}} / {{total}}">
            <b style="width:{{pct}}%"></b>
            <i class="nah-proj-half {{#if passed}}is-passed{{/if}}" style="left:{{half}}%" data-tooltip="{{localize 'NEONHOME.Project.Halfway'}}"></i>
            <span>{{done}} / {{total}}</span>
          </div>
          <footer>
            {{#if checkDue}}<button type="button" class="nah-primary" data-action="dtProjRoll" {{#unless @root.dt.can}}disabled{{/unless}}><i class="fa-solid fa-dice-d10"></i> {{localize "NEONHOME.Project.Roll"}}</button>{{/if}}
            {{#each steps}}<button type="button" data-action="dtProjWork" data-minutes="{{minutes}}" {{#unless @root.dt.can}}disabled{{/unless}}><i class="fa-regular fa-clock"></i> {{label}}</button>{{/each}}
            {{#if noTime}}<small class="nah-hint">{{localize "NEONHOME.Project.NoTime"}}</small>{{/if}}
            {{#if pick}}{{#with pick}}<div class="nah-proj-pick">
          <div class="nah-timepick {{#if over}}is-over{{/if}}" data-max="{{max}}" data-value="{{value}}" data-max-label="{{maxLabel}}" {{#if name}}data-field="{{name}}"{{/if}}>
            <input type="range" min="0" max="{{max}}" step="15" value="{{value}}" data-tp-range aria-label="{{localize 'NEONHOME.Project.Pick'}}">
            <span class="nah-tp-boxes">
              <label><input type="number" min="0" step="1" value="{{d}}" data-tp-unit="1440" aria-label="{{localize 'NEONHOME.Project.Days'}}"><span>d</span></label>
              <label><input type="number" min="0" step="1" value="{{h}}" data-tp-unit="60" aria-label="{{localize 'NEONHOME.Project.Hours'}}"><span>h</span></label>
              <label><input type="number" min="0" step="1" value="{{m}}" data-tp-unit="1" aria-label="{{localize 'NEONHOME.Project.Minutes'}}"><span>m</span></label>
            </span>
            <small class="nah-tp-msg" data-tp-msg>{{#if over}}{{localize "NEONHOME.Project.TooMuch" max=maxText}}{{else}}{{label}} &middot; {{maxLabel}}{{/if}}</small>
          </div>
              <button type="button" class="nah-primary" data-action="dtProjWork" data-minutes="pick" data-tp-confirm {{#if stop}}disabled{{/if}} {{#unless @root.dt.can}}disabled{{/unless}}><i class="fa-solid fa-hourglass-half"></i> {{localize "NEONHOME.Project.PutIn"}}</button>
            </div>{{/with}}{{/if}}
            <button type="button" class="nah-icon-btn is-danger" data-action="dtProjAbandon" data-tooltip="{{localize 'NEONHOME.Project.Abandon'}}"><i class="fa-solid fa-trash"></i></button>
          </footer>
        </li>
        {{else}}
        <li class="nah-hint">{{localize "NEONHOME.Project.None"}}</li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if strip}}
      <ul class="nah-dt-strip-list">
        {{#each strip}}
        <li class="{{#if picked}}is-picked{{/if}}">
          <label><input type="checkbox" data-strip-pick="{{id}}" {{#if picked}}checked{{/if}}><img src="{{img}}" alt=""><span><b>{{name}}</b><small>{{value}}{{#if multi}} {{localize "NEONHOME.Strip.Each"}}{{/if}}</small></span></label>
          {{#if multi}}<input type="number" data-strip-qty="{{id}}" value="{{qty}}" min="1" max="{{amount}}" data-tooltip="{{localize 'NEONHOME.Strip.HowMany' n=amount}}">{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if blocked}}<p class="nah-maint-note nah-locked"><i class="fa-solid fa-circle-exclamation"></i> {{blocked}}</p>{{/if}}
      {{#unless @root.dt.can}}<p class="nah-maint-note nah-locked"><i class="fa-solid fa-mug-hot"></i> {{localize "NEONHOME.Downtime.Only.actions"}}</p>{{/unless}}
      {{#unless workshop}}{{#unless projects}}
      <div class="nah-maint-actions">
        <button type="button" class="nah-primary" data-action="dtPerform" {{#unless canDo}}disabled{{/unless}}>
          {{#if maker}}<i class="fa-solid fa-diagram-project"></i> {{localize "NEONHOME.Project.Start"}}{{else if stripping}}<i class="fa-solid fa-gears"></i> {{localize "NEONHOME.Strip.Do"}}{{else if noRoll}}<i class="fa-regular fa-clock"></i> {{localize "NEONHOME.Downtime.Spend"}}{{else}}<i class="fa-solid fa-dice-d10"></i> {{localize "NEONHOME.Downtime.Do"}}{{/if}}{{#if timeLabel}} <small>{{timeLabel}}</small>{{/if}}
        </button>
      </div>
      {{/unless}}{{/unless}}

      {{#if hauls}}
      <div class="nah-dt-hauls">
        <h4><i class="fa-solid fa-boxes-stacked"></i> {{localize "NEONHOME.Salvage.Hauls"}}</h4>
        {{#each hauls}}
        <div class="nah-haul" data-haul="{{id}}">
          <header><b>{{title}}</b><span>{{localize "NEONHOME.Salvage.LeftOf" left=left worth=worth}}</span></header>
          <div class="nah-meter"><b style="width:{{pct}}%"></b></div>
          {{#if taken}}<small class="nah-hint">{{localize "NEONHOME.Salvage.TakenSoFar" items=taken}}</small>{{/if}}
          <div class="nah-dt-drop" data-drop="haul"><i class="fa-solid fa-arrow-down-to-bracket"></i><span>{{localize "NEONHOME.Salvage.DropHere" category=category}}</span></div>
          <div class="nah-haul-tiers">
            <small>{{localize "NEONHOME.Salvage.AsMaterials"}}</small>
            {{#each tiers}}<button type="button" data-action="dtHaulTier" data-tier="{{tier}}"><i class="fa-solid fa-box"></i> {{label}}</button>{{/each}}
          </div>
          <footer><button type="button" class="is-danger" data-action="dtHaulLeave"><i class="fa-solid fa-person-walking-arrow-right"></i> {{localize "NEONHOME.Salvage.Leave"}}</button></footer>
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{/with}}

      <details class="nah-dt-log" open>
        <summary><i class="fa-solid fa-list"></i> {{localize "NEONHOME.Downtime.Log"}}</summary>
        <ul>
          {{#each log}}<li class="{{#if ours}}is-ours{{/if}}"><span>{{label}}</span><small>{{time}}</small></li>
          {{else}}<li class="nah-hint">{{localize "NEONHOME.Downtime.LogEmpty"}}</li>{{/each}}
        </ul>
      </details>
    </main>
  </div>
</div>
{{/with}}
