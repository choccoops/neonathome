{
  "id": "cpr-neon-at-home",
  "title": "Neon At Home: Loadout, Vehicle Bay, Weaponbench, Maintenance, Downtime & Biomonitor for Cyberpunk RED",
  "description": "A character's home suite for Cyberpunk RED - CORE: a Loadout with carry slots by armor class, armor upgrades, weight and a home stash; a Vehicle Bay with bays from the character's home; a Weaponbench for attachments; Maintenance from the Breaking Your Stuff DLC; Downtime actions from the core rulebook, spending Neon Hub's downtime; and a Biomonitor for HP, injuries, cyberware, Humanity, Empathy tiers and Syndromes.",
  "version": "1.6.6",
  "authors": [
    {
      "name": "Neon At Home contributors"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "12"
  },
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": {
          "minimum": "0.92",
          "verified": "0.92.4"
        }
      }
    ],
    "recommends": [
      {
        "id": "cpr-neon-hub",
        "type": "module",
        "reason": "Vehicle bays come from the parking of the character's Neon Hub home or household; maintenance months follow its Rent Day; downtime actions spend its downtime credits."
      },
      {
        "id": "mmutons-cyberpunk-red-vas",
        "type": "module",
        "reason": "Vehicle actors on MMuton's Vehicle Actor Sheet show their crew seats, mounted weapons and upgrades in the Vehicle Bay."
      },
      {
        "id": "cpr-neon-combat-manager",
        "type": "module",
        "reason": "Encumbered and Overloaded become Neon Conditions: in its Condition Lab and token HUD, and applied through it."
      },
      {
        "id": "item-piles",
        "type": "module",
        "reason": "Items a character drops (a lost hand, a malfunction) land in a pile beside their token."
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/neon-home.css"
  ],
